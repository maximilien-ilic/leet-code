#Finding the median of two sorted arrays using partitioning or binary search for optimal efficiency

class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: float
        """
        nums_final = []
        if nums1 == [] and nums2 == []:
            return 0
        while nums1 != [] or nums2 != []:

            if nums1 == []:
                nums_final.append(nums2[0])
                nums2.pop(0)                

            elif nums2 == []:
                nums_final.append(nums1[0])
                nums1.pop(0)
            else:
                if nums1[0] <= nums2[0]:
                    nums_final.append(nums1[0])
                    nums1.pop(0)
                else:
                    nums_final.append(nums2[0])
                    nums2.pop(0)
        if len(nums_final) % 2 == 0:
            return (float(nums_final[len(nums_final)//2] + nums_final[len(nums_final)//2 -1]  )) / 2
        else:
            return nums_final[(len(nums_final)+1)//2 -1]

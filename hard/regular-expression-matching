#Implementing regex matching with wildcard support using recursive backtracking or dynamic programming.

class Solution:
    def isMatch(self, s: str, p: str) -> bool:
        if len(p) == 0:
            return s == ""
        
        premier_match = len(s) > 0 and (p[0] == s[0] or p[0] == ".")
        
        if len(p) >= 2 and p[1] == "*":
            return self.isMatch(s, p[2:]) or (premier_match and self.isMatch(s[1:], p))
        else:
            return premier_match and self.isMatch(s[1:], p[1:])

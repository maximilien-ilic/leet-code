#Finding the longest contiguous substring without repeating characters using window expansion and contraction.
class Solution(object):
    def lengthOfLongestSubstring(self,s):
        """
        :type s: str
        :rtype: int
        """
        longuest = ""
        result = ""
        charac = []
        if s == "":
            return 0
        for i in range(len(s)):
            result = s[i]
            charac = [s[i]]
            for u in range(i+1,len(s)):
                if s[u] in charac:
                    break
                else:
                    result += s[u]
                    charac.append(s[u])
                if len(longuest) < len(result):
                    longuest = result
        return max(len(longuest),1)

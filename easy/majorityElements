class Solution:
    def majorityElement(self, nums: List[int]) -> int:
        if len(nums) == 1:
            return nums[0]
        nums = sorted(nums)
        majority = 0
        actuelle = 0
        index = nums[0]
        for i in range(len(nums)):
            if nums[i] == index:
                actuelle += 1
            else:
                index = nums[i]
                actuelle = 1
            if actuelle > majority:
                majority = actuelle
            if majority > len(nums)/2:
                return nums[i]
class Solution:
    def intersection(self, nums1: List[int], nums2: List[int]) -> List[int]:
        result = []
        nums1 = sorted(nums1)
        nums2 = sorted(nums2)
        while nums1 != [] and nums2 != []:
            if nums1[0] == nums2[0]:
                if nums1[0] in result:
                    nums1.pop(0)
                    nums2.pop(0)
                else:
                    result.append(nums1[0])
                    nums1.pop(0)
                    nums2.pop(0)
            elif nums1[0] > nums2[0]:
                nums2.pop(0)
            else:
                nums1.pop(0)
        return result
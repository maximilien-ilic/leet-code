#Given an integer x, return true if x is a palindrome, and false otherwise.
#Sans convertir en str


class Solution(object):
    def isPalindrome(self, x):
        """
        :type x: int
        :rtype: bool
        """
        reverse_result = 0
        reverse = x
        multi = 1
        if x < 0 :
            return False
        while reverse != 0:
            reverse_result = reverse_result * 10
            reverse_result += (reverse % 10)
            reverse = reverse // 10
        if reverse_result == x :
            return True
        else:
            return False

class Solution:
    def generate(self, numRows: int) -> List[List[int]]:
        if numRows == 1 :
            return [[1]]
        if numRows == 2 :
            return [[1], [1,1]]           
        else :
            queud = self.generate(numRows - 1)
            last = queud[-1]
            nouvelle_ligne = [1]
            for i in range(len(last) - 1):
                nouvelle_ligne.append(last[i] + last[i+1])
            nouvelle_ligne.append(1)
            return  queud + [nouvelle_ligne]

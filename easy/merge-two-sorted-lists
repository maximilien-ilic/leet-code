#Merging two sorted linked lists using a dummy head and two-pointer traversal.

# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        head = ListNode(0)
        result = head 
        while list1 != None and list2 != None:
            if list1.val <= list2.val :
                result.next = ListNode(list1.val)
                result = result.next
                list1 = list1.next
            else:
                result.next = ListNode(list2.val)
                result = result.next  
                list2 = list2.next     
        if list1 == None:
            result.next = list2
        else:
            result.next = list1           
        head.next = result
        return head.next

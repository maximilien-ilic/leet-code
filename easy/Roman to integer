#Convert a Roman numeral string to its integer equivalent using symbol values and a subtraction rule for specific pairs.

class Solution(object):
    def romanToInt(self, s):
        """
        roman[s[i]]
        :type s: str
        :rtype: int
        """
        result = 0
        roman = {"I":1,"V":5,"X":10,"L":50,"C":100,"D":500,"M":1000}
        for i in range (len(s)):
            if i == len(s)-1:
                result += roman[s[i]]
            else:
                if roman[s[i]] < roman[s[i+1]] :
                    result -= roman[s[i]]
                else:
                    result += roman[s[i]]
        return result

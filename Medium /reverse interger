#Reversing digits via modulo arithmetic while checking 32-bit integer overflow constraints.

class Solution:
    def reverse(self, x: int) -> int:

        if x >= 0:
            reverse = 0
            while x != 0:
                reverse = reverse * 10
                reverse += x % 10
                x = x // 10
        else:
            reverse = -0
            x = abs(x)
            while x != 0:
                reverse = reverse * 10
                reverse += x % 10
                x = x // 10
            reverse = -reverse
            if reverse < -2**31:
                return 0
        if reverse > 2**31 -1:
            return 0
        else:
            return reverse

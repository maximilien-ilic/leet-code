#Calculating list length and using modulo arithmetic to find the new rotation point efficiently

# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def rotateRight(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        n = 0
        tete = head
        original = head
        if head == None:
            return None
        while head.next != None :
            head = head.next
            n += 1
        if k % (n + 1) == 0:
            return original
        for i in range(n - k%(n+1)):
            tete = tete.next
        queud = tete.next
        tete.next = None
        head.next = original
        return queud


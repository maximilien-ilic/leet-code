#Generating all possible combinations using iterative mapping or backtracking.



class Solution(object):
    def letterCombinations(self, digits):
        """
        :type digits: str
        :rtype: List[str]
        """ 
        result = []
        temp = []
        phone = {"2": "abc" , "3": "def" , "4": "ghi" , "5": "jkl" , "6": "mno" , "7": "pqrs" , "8": "tuv" , "9": "wxyz"}
        for i in range(len(digits)):
            temp = []
            if result == []:
                for j in range(len(phone[digits[i]])):
                    temp.append(phone[digits[i]][j])
            else:
                for j in range(len(phone[digits[i]])):
                    for t in range(len(result)):
                        temp.append(result[t] +phone[digits[i]][j])
            result = temp
        return result
